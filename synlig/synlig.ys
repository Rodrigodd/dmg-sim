read_verilog -sv -icells \
cells/dffsr.sv \
cells/dffr_bp.sv \
cells/tffd.sv \
cells/nor_srlatch.sv \
cells/dlatch_a.sv \
cells/drlatch.sv \

read_systemverilog -dump_ast1 -dump_ast2 -parseall \
