dmg.sv

read_verilog \
../dmgcpu/HDL/sm83/_GekkioNames.v \
../dmgcpu/HDL/sm83/ALU.v \
../dmgcpu/HDL/sm83/Bottom.v \
../dmgcpu/HDL/sm83/DataMux.v \
../dmgcpu/HDL/sm83/Decoder1.v \
../dmgcpu/HDL/sm83/Decoder2.v \
../dmgcpu/HDL/sm83/Decoder3.v \
../dmgcpu/HDL/sm83/IDU.v \
